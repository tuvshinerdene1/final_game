title = "1996-12-10"
pages = Array[String](["Өчигдөр 03:59 цагийн орчимд Пагма нэртэй, 60 гаруй насны эмэгтэй өөрийн орцондоо нас барсан байдалтай олдсон хэрэг гарчээ.", "Талийгаачийн хоёр чихийг тастсан байсан бөгөөд уг чихнүүдийг хэргийн газраас хайсан боловч олдоогүй талаар Цагдаагийн ерөнхий газрын ажилтан Энгүүнбаяр мэдээллээ."])
