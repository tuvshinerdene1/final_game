script = ExtResource("1_d88py")
pages = Array[String](["Алга болсон нялх хүүхдийг олсон талаар цагдаагийн байгууллагаас мэдээллээ. Харамсалтай нь, хүүхдийн хоолойн хөвчийг хүчээр авсан байдалтай байсан нь ", "урьдчилсан шалгалтаар тогтоогдсон бөгөөд уг хэргийг холбогдох байгууллагууд шалгаж байна."])
